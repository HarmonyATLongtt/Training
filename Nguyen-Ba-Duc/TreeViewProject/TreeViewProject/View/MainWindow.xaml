<Window x:Class="TreeViewProject.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TreeViewProject.ViewModel"
        xmlns:converters="clr-namespace:TreeViewProject.Converter"
        xmlns:behaviors="clr-namespace:TreeViewProject.Behaviors"
        xmlns:gif="clr-namespace:WpfAnimatedGif;assembly=WpfAnimatedGif"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Title="TreeView with A"
        Height="500" Width="700"
        Background="#F4F6F8">
    <!--KeyDown="Window_KeyDown"-->
    <Window.InputBindings>
        <KeyBinding Key="C"
                    Modifiers="Control"
                    Command="{Binding CopyCommand}" />

        <KeyBinding Key="X"
                    Modifiers="Control"
                    Command="{Binding CutCommand}" />
        <KeyBinding Key="V"
                    Modifiers="Control"
                    Command="{Binding PasteCommand}" />

        <KeyBinding Key="Delete"
                    Command="{Binding DeleteCommand}" />
        <KeyBinding Key="F1"
                    Command="{Binding HelpCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <converters:StringToUriConverter x:Key="StringToUriConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFF" />
            <Setter Property="Foreground" Value="#333" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#CCC" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E6F0FF" />
                                <Setter Property="BorderBrush" Value="#66A3FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#CCE0FF" />
                                <Setter Property="BorderBrush" Value="#3399FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.7" />
                                <Setter Property="Foreground" Value="Gray" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- TreeView panel-->
        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="10"
                BorderBrush="#DDD" BorderThickness="1" Margin="0,0,10,0">
            <TreeView x:Name="MyTree" FontSize="14"
                  FontFamily="Segoe UI"
                  BorderThickness="0"
                  ItemsSource="{Binding TreeVM.RootNodes}"
                  SelectedItemChanged="TreeView_SelectedItemChanged"
                  GotFocus="TreeView_GotFocus"
                  LostFocus="TreeView_LostFocus">

                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TreeViewItem">
                                    <StackPanel>
                                        <!-- Header -->

                                        <DockPanel>
                                            <!-- Custom ToggleButton -->
                                            <ToggleButton x:Name="Expander"  Width="12" Height="12" Margin="0,0,4,0"
                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                      ClickMode="Press"
                                                      Focusable="False">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border BorderBrush="Black"
                                                                BorderThickness="1"
                                                                Background="White">
                                                            <Grid>
                                                                <!-- Horizontal line -->
                                                                <Rectangle Height="1" Width="6" Fill="Black"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                <!-- Vertical line (only visible when collapsed) -->
                                                                <Rectangle x:Name="VerticalLine" Width="1" Height="6" Fill="Black"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="VerticalLine" Property="Visibility" Value="Collapsed" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>

                                            <!-- Header -->
                                            <Border x:Name="Bd"
                                                    Padding="2"
                                                    Background="Transparent"
                                                    HorizontalAlignment="Left">
                                                <ContentPresenter x:Name="PART_Header"
                                                    ContentSource="Header"
                                                    RecognizesAccessKey="True" />
                                            </Border>
                                        </DockPanel>
                                        <!-- Children -->
                                        <ItemsPresenter x:Name="ItemsHost"
                                        Margin="20,0,0,0"
                                        Visibility="{Binding IsExpanded,
                                                     RelativeSource={RelativeSource TemplatedParent},
                                                     Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </StackPanel>

                                    <!-- Triggers -->
                                    <ControlTemplate.Triggers>

                                        <!-- Hide expander if no children -->
                                        <Trigger Property="HasItems" Value="false">
                                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                                        </Trigger>
                                        <!-- Show items when expanded -->
                                        <Trigger Property="IsExpanded" Value="true">
                                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                                        </Trigger>

                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#0078D7" />
                                            <!-- Blue -->
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="False">
                                            <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="Black" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.Resources>

                    <HierarchicalDataTemplate DataType="{x:Type vm:NodeViewModel}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">

                            <!-- Node text -->
                            <TextBlock Text="{Binding Name}" Name="textblock">
                                <TextBlock.ToolTip>
                                    <ToolTip Name="tooltip">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="Opened">
                                                <i:InvokeCommandAction  Command="{Binding Path = DataContext.TooltipOpenedCommand ,
                                        RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                                            </i:EventTrigger>
                                            <i:EventTrigger EventName="Closed">
                                                <i:InvokeCommandAction  Command="{Binding Path = DataContext.TooltipClosedCommand ,
                                        RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>

                                        <StackPanel>
                                            <!-- Tooltip ngắn -->
                                            <TextBlock Text="{Binding Description}" FontWeight="Bold" Foreground="Black" />

                                            <!-- Tooltip chi tiết -->
                                            <StackPanel x:Name="DetailPanel" Visibility="{Binding IsDetailVisible}" Margin="5,5,0,0">
                                                <TextBlock Text="{Binding DetailDescription}" TextWrapping="Wrap" />
                                                <Image Source="{Binding ImagePath}" Width="100" Height="100"  Margin="0,5" />

                                                <Separator Margin="0,5" />

                                                <TextBlock Text="Press F1 for more help" FontWeight="Bold" Foreground="Black" />
                                            </StackPanel>
                                        </StackPanel>
                                    </ToolTip>
                                </TextBlock.ToolTip>

                                <!-- Style để mờ khi IsMarked = true -->
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Opacity" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                                <Setter Property="Opacity" Value="0.5" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
            </TreeView>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Grid Margin="0,5" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">

                <!-- Image -->
                <Image Source="{Binding TreeVM.SelectedNodeImagePath}"
                       Visibility="{Binding TreeVM.IsImageVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                <!--GIF -->
                <Image gif:ImageBehavior.AnimatedSource="{Binding TreeVM.SelectedNodeGifPath, Converter={StaticResource StringToUriConverter}}"
                    gif:ImageBehavior.RepeatBehavior="Forever"
                    Visibility="{Binding TreeVM.IsGifVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- Video -->
                <MediaElement Source="{Binding TreeVM.SelectedNodeVideoPath}"
                            LoadedBehavior="Manual"
                            UnloadedBehavior="Stop"
                            Stretch="Uniform"
                            Name="VideoPlayer"
                            Visibility="{Binding TreeVM.IsVideoVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <i:Interaction.Behaviors>
                        <behaviors:MediaElementLoopBehavior />
                    </i:Interaction.Behaviors>
                </MediaElement>
            </Grid>

            <!-- Buttons -->
            <StackPanel Grid.Row="1" Margin="10" VerticalAlignment="Top" Orientation="Vertical" Width="150">
                <Button Content="Expand All" Command="{Binding TreeVM.ExpandAllCommand}" Style="{StaticResource ButtonStyle}" />
                <Button Content="Collapse All" Command="{Binding TreeVM.CollapseAllCommand}" Style="{StaticResource ButtonStyle}" />
                <Button Content="Invert" Command="{Binding TreeVM.InvertCommand}" Style="{StaticResource ButtonStyle}" />
                <Separator Margin="0,5" />
                <Button x:Name="CopyButton" Content="Copy" Command="{Binding CopyCommand}" Style="{StaticResource ButtonStyle}" />
                <Button x:Name="CutButton" Content="Cut" Command="{Binding CutCommand}" Style="{StaticResource ButtonStyle}" />
                <Button x:Name="PasteButton" Content="Paste" Command="{Binding PasteCommand}" Style="{StaticResource ButtonStyle}" />
                <Button x:Name="DeleteButton" Content="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource ButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>