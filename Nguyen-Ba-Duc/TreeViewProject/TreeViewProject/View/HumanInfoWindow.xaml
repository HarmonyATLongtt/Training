<UserControl x:Class="TreeViewProject.View.HumanInfoWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:TreeViewProject.Behaviors"
             xmlns:gif="clr-namespace:WpfAnimatedGif;assembly=WpfAnimatedGif"
             mc:Ignorable="d" Width="400" Height="500">

    <Border Padding="10" CornerRadius="10" Background="White"
            BorderBrush="#DDD" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="5*" />
                <RowDefinition Height="3*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <!-- Image -->
            <Border Grid.Row="0" Grid.Column="0" CornerRadius="8" BorderBrush="#CCC" BorderThickness="1"
                    Width="150" Height="150" VerticalAlignment="Top" HorizontalAlignment="Center">
                <Image Stretch="Uniform" Source="{Binding ImagePath, Mode=OneWay }" />
            </Border>
            <!--Info-->
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Top">
                <TextBlock Text="Name:" FontWeight="Bold" FontSize="14" Foreground="#333" />
                <TextBlock Text="{Binding Name, Mode=OneWay}" Margin="0,0,0,10" />

                <TextBlock Text="Birthday:" FontWeight="Bold" FontSize="14" Foreground="#333" />
                <TextBlock Text="{Binding Birthday, StringFormat='dd/MM/yyyy', Mode=OneWay}" Margin="0,0,0,10" />

                <TextBlock Text="Address:" FontWeight="Bold" FontSize="14" Foreground="#333" />
                <TextBlock Text="{Binding Address, Mode=OneWay}" Margin="0,0,0,10" />
            </StackPanel>
            <!-- TextBox multiline -->
            <TextBox Grid.Column="0" Grid.Row="1" Text="{Binding Description, Mode=OneWay}" Grid.ColumnSpan="2"
                     Margin="0,10,0,0"
                     Width="350"
                     TextWrapping="Wrap"
                     IsReadOnly ="True"
                     HorizontalAlignment="Center"
                     VerticalScrollBarVisibility="Auto"
                     FontSize="14"
                     Padding="8"
                     BorderBrush="#999"
                     BorderThickness="1" />
            <!--<Grid>
                 Image
                <Image Source="{Binding TreeVM.SelectedNodeImagePath}"
       Visibility="{Binding TreeVM.IsImageVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                GIF
                <Image gif:ImageBehavior.AnimatedSource="{Binding TreeVM.SelectedNodeGifPath, Converter={StaticResource StringToUriConverter}}"
    gif:ImageBehavior.RepeatBehavior="Forever"
    Visibility="{Binding TreeVM.IsGifVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

                 Video
                <MediaElement Source="{Binding TreeVM.SelectedNodeVideoPath}"
            LoadedBehavior="Manual"
            UnloadedBehavior="Stop"
            Stretch="Uniform"
            Name="VideoPlayer"
            Visibility="{Binding TreeVM.IsVideoVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <i:Interaction.Behaviors>
                        <behaviors:MediaElementLoopBehavior />
                    </i:Interaction.Behaviors>
                </MediaElement>
            </Grid>-->
        </Grid>
    </Border>
</UserControl>