<UserControl x:Class="TreeViewProject.View.ProductInfoWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TreeViewProject.View"
             xmlns:behaviors="clr-namespace:TreeViewProject.Behaviors"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             Height="600" Width="400">

    <UserControl.Resources>
        <!-- Style cho tất cả TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Style cho tất cả Label -->
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#333" />
        </Style>
    </UserControl.Resources>
    <Border Padding="10" CornerRadius="10" Background="White"
        BorderBrush="#DDD" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="160" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <!--Info-->
                    <Label Grid.Column="0" Grid.Row="0" Content="Price :" />
                    <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding Price, Mode=OneWay}" />
                    <Label Grid.Column="0" Grid.Row="1" Content="Expire Date :" />
                    <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding ExpireDate, StringFormat='dd/MM/yyyy',Mode=OneWay}" />
                    <Label Grid.Column="0" Grid.Row="2" Content="Provider :" />
                    <TextBox  Grid.Column="1" Grid.Row="2" Text="{Binding Provider, Mode=OneWay}" />
                    <Label Grid.Column="0" Grid.Row="3" Content="Factory :" />
                    <TextBox Grid.Column="1" Grid.Row="3" Text="{Binding Factory,Mode=OneWay}" />
                </Grid>
                <StackPanel Grid.Row="1" VerticalAlignment="Top">
                    <Label Content="Comments :" />
                    <TextBox Height="60" Text="{Binding Description, Mode=OneWay}"
                            Margin="0,10,0,0"
                            Width="350"
                            TextWrapping="Wrap"
                            HorizontalAlignment="Center"
                            VerticalScrollBarVisibility="Auto"
                            VerticalContentAlignment="Top"
                            Padding="8"
                            BorderBrush="#999"
                            BorderThickness="1">
                        <i:Interaction.Behaviors>
                            <behaviors:CopyPasteBehavior  MainVM= "{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </i:Interaction.Behaviors>
                    </TextBox>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="20,0,0,0" VerticalAlignment="Top">
                    <Label Content="Address :" Margin="0,0,0,2" />
                    <TextBox TextWrapping="Wrap" Text="{Binding Address, Mode=OneWay}" Margin="5,0,0,10" />
                </StackPanel>
                <!-- Image -->
                <Border Grid.Column="1" CornerRadius="8" BorderBrush="#CCC" BorderThickness="1"
                    Width="150" Height="150" VerticalAlignment="Top" HorizontalAlignment="Center">
                    <Image Stretch="Uniform" Source="{Binding ImagePath, Mode=OneWay}" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>