<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:TreeViewProject.CustomControls">

    <Style TargetType="{x:Type local:GreenCheckControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:GreenCheckControl}">
                    <Grid>
                        <!-- Vòng tròn xanh -->
                        <Ellipse Stroke="{TemplateBinding Stroke}"
                                 StrokeThickness="2"
                                 Fill="Transparent" />

                        <!-- Dấu tích xanh -->
                        <Path Stroke="{TemplateBinding Stroke}"
                              StrokeThickness="2"
                              StrokeEndLineCap="Round"
                              StrokeStartLineCap="Round"
                              Data="M 20 40 L 35 55 L 60 25"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Width="8" Height="8" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>