<Window x:Class="FirstCommand.View.ViewComboboxWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:FirstCommand.View"
             mc:Ignorable="d"
             Height="300" Width="400"
             WindowStartupLocation="CenterScreen">

    <StackPanel Width="100" Height="200" HorizontalAlignment="Center" Orientation="Vertical">
        <!--<Label Content="List View "></Label>
        <ComboBox Width="200" x:Name="comboBoxViews"></ComboBox>-->
        <Label Content="Offset"></Label>
        <TextBox x:Name="tbNameOffset"></TextBox>
        <Label Content="Depth"></Label>
        <TextBox x:Name="tbNameDepth"></TextBox>
        <Button Content="Submit" Margin="0,10,0,0" Click="Button_Click"></Button>
    </StackPanel>
</Window>